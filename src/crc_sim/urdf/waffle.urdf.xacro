<?xml version="1.0"?>
<!--
  TurtleBot3 WAFFLE - URDF for the UEH CRC 2026 simulation.
  Geometry, masses and inertias are taken unchanged from turtlebot3_description
  (ROBOTIS, Apache-2.0), with Gazebo plugins added for:
      - diff drive      -> /cmd_vel , /odom , TF odom->base_footprint
      - LiDAR LDS 360   -> /scan
      - Camera RGB      -> /camera/image_raw , /camera/camera_info
      - IMU             -> /imu

  Arguments (xacro arg):
      use_mesh      : true  -> use the turtlebot3_description STL meshes
                      false -> use simple boxes/cylinders (no TB3 package needed)
      camera_pitch  : camera downward tilt (rad). 0.0 = stock Waffle.
                      Use 0.3-0.5 to see the lane markings more clearly.
      lidar_range   : LiDAR maximum range (m)
-->
<robot name="turtlebot3_waffle" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_mesh"     default="true"/>
  <xacro:arg name="camera_pitch" default="0.0"/>
  <xacro:arg name="lidar_range"  default="3.5"/>
  <!-- Where the TurtleBot3 meshes live. The launch file overrides this
       with an absolute file:// path so Gazebo never has to resolve
       package:// through its model database. -->
  <xacro:arg name="mesh_prefix"  default="package://turtlebot3_description"/>
  <!-- Body colour. Orange, to stand out against the dark track. -->
  <xacro:arg name="body_color"   default="Gazebo/Orange"/>
  <xacro:arg name="body_rgba"    default="1.0 0.45 0.05 1.0"/>

  <xacro:property name="use_mesh"     value="$(arg use_mesh)"/>
  <xacro:property name="camera_pitch" value="$(arg camera_pitch)"/>
  <xacro:property name="lidar_range"  value="$(arg lidar_range)"/>
  <xacro:property name="mesh"         value="$(arg mesh_prefix)"/>
  <xacro:property name="body_color"   value="$(arg body_color)"/>

  <!-- Basic Waffle parameters -->
  <xacro:property name="wheel_radius"     value="0.033"/>
  <xacro:property name="wheel_separation" value="0.287"/>

  <material name="dark">        <color rgba="0.20 0.20 0.20 1.0"/></material>
  <material name="light_black"> <color rgba="0.10 0.10 0.10 1.0"/></material>
  <material name="body">        <color rgba="$(arg body_rgba)"/></material>
  <material name="orange">      <color rgba="1.00 0.42 0.04 1.0"/></material>

  <!-- ================================================================== -->
  <!--  BASE                                                              -->
  <!-- ================================================================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 0.010" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="-0.064 0 0.0" rpy="0 0 0"/>
      <geometry>
        <xacro:if value="${use_mesh}">
          <mesh filename="${mesh}/meshes/bases/waffle_base.stl"
                scale="0.001 0.001 0.001"/>
        </xacro:if>
        <xacro:unless value="${use_mesh}">
          <box size="0.266 0.266 0.094"/>
        </xacro:unless>
      </geometry>
      <material name="body"/>
    </visual>

    <collision>
      <origin xyz="-0.064 0 0.047" rpy="0 0 0"/>
      <geometry><box size="0.266 0.266 0.094"/></geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.3729096e+00"/>
      <inertia ixx="8.7002718e-03" ixy="-4.7576583e-05" ixz="1.1160499e-04"
               iyy="8.6195418e-03" iyz="-3.5422299e-06" izz="1.4612727e-02"/>
    </inertial>
  </link>

  <!-- ================================================================== -->
  <!--  WHEELS                                                            -->
  <!-- ================================================================== -->
  <xacro:macro name="wheel" params="side reflect">
    <joint name="wheel_${side}_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="wheel_${side}_link"/>
      <origin xyz="0.0 ${reflect * 0.144} 0.023" rpy="-1.57 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="wheel_${side}_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.57 0 0"/>
        <geometry>
          <xacro:if value="${use_mesh}">
            <mesh filename="${mesh}/meshes/wheels/${side}_tire.stl"
                  scale="0.001 0.001 0.001"/>
          </xacro:if>
          <xacro:unless value="${use_mesh}">
            <cylinder length="0.018" radius="${wheel_radius}"/>
          </xacro:unless>
        </geometry>
        <material name="dark"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder length="0.018" radius="${wheel_radius}"/></geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.1E-01"/>
        <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09"
                 iyy="1.1192413e-05" iyz="-1.4400107e-11" izz="2.0712558e-05"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:wheel side="left"  reflect="1"/>
  <xacro:wheel side="right" reflect="-1"/>

  <!-- ================================================================== -->
  <!--  CASTERS - the Waffle has two at the rear                          -->
  <!-- ================================================================== -->
  <xacro:macro name="caster" params="name y">
    <joint name="caster_${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="caster_${name}_link"/>
      <origin xyz="-0.177 ${y} -0.004" rpy="-1.57 0 0"/>
    </joint>
    <link name="caster_${name}_link">
      <collision>
        <origin xyz="0 0.001 0" rpy="0 0 0"/>
        <geometry><box size="0.030 0.009 0.020"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.005"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0"
                 iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:caster name="back_left"  y="0.064"/>
  <xacro:caster name="back_right" y="-0.064"/>

  <!-- ================================================================== -->
  <!--  IMU                                                               -->
  <!-- ================================================================== -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0.0 0 0.068" rpy="0 0 0"/>
  </joint>
  <link name="imu_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <!-- ================================================================== -->
  <!--  LiDAR  (LDS-01 / LDS-02, 360 degree scan)                         -->
  <!-- ================================================================== -->
  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="base_scan"/>
    <origin xyz="-0.064 0 0.122" rpy="0 0 0"/>
  </joint>

  <link name="base_scan">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <xacro:if value="${use_mesh}">
          <mesh filename="${mesh}/meshes/sensors/lds.stl"
                scale="0.001 0.001 0.001"/>
        </xacro:if>
        <xacro:unless value="${use_mesh}">
          <cylinder length="0.0315" radius="0.0508"/>
        </xacro:unless>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0.015 0 -0.0065" rpy="0 0 0"/>
      <geometry><cylinder length="0.0315" radius="0.055"/></geometry>
    </collision>
    <inertial>
      <mass value="0.114"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ================================================================== -->
  <!--  CAMERA RGB                                                        -->
  <!-- ================================================================== -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="0.064 -0.065 0.094" rpy="0 ${camera_pitch} 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.015 0.130 0.022"/></geometry>
      <material name="dark"/>
    </visual>
    <inertial>
      <mass value="0.035"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="camera_rgb_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_rgb_frame"/>
    <origin xyz="0.005 0.065 0.013" rpy="0 0 0"/>
  </joint>
  <link name="camera_rgb_frame"/>

  <joint name="camera_rgb_optical_joint" type="fixed">
    <parent link="camera_rgb_frame"/>
    <child  link="camera_rgb_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>
  <link name="camera_rgb_optical_frame"/>

  <!-- ================================================================== -->
  <!--  GAZEBO : colours and friction                                     -->
  <!-- ================================================================== -->
  <gazebo reference="base_link">   <material>${body_color}</material></gazebo>
  <gazebo reference="base_scan">   <material>Gazebo/FlatBlack</material></gazebo>
  <gazebo reference="camera_link"> <material>Gazebo/Black</material></gazebo>

  <gazebo reference="wheel_left_link">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>500000.0</kp><kd>10.0</kd>
    <minDepth>0.001</minDepth><maxVel>0.1</maxVel>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="wheel_right_link">
    <mu1>1.0</mu1><mu2>1.0</mu2>
    <kp>500000.0</kp><kd>10.0</kd>
    <minDepth>0.001</minDepth><maxVel>0.1</maxVel>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <gazebo reference="caster_back_left_link">
    <mu1>0.1</mu1><mu2>0.1</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
    <minDepth>0.001</minDepth><maxVel>1.0</maxVel>
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="caster_back_right_link">
    <mu1>0.1</mu1><mu2>0.1</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
    <minDepth>0.001</minDepth><maxVel>1.0</maxVel>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <!-- ================================================================== -->
  <!--  GAZEBO : PLUGIN                                                   -->
  <!-- ================================================================== -->

  <!-- Differential drive: consumes /cmd_vel, publishes /odom and TF odom->base_footprint -->
  <gazebo>
    <plugin name="crc_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>30</update_rate>
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${wheel_radius * 2}</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <!-- 0 = ENCODER, integrated from wheel rotation, so it drifts like a real
           robot. The plugin default is 1 = WORLD, which publishes the exact
           Gazebo pose: that turns /odom into a ground-truth feed and lets a
           solution drive the whole course on coordinates without perceiving
           anything. -->
      <odometry_source>0</odometry_source>
    </plugin>
  </gazebo>

  <!-- Publish /joint_states so robot_state_publisher can move the wheels -->
  <gazebo>
    <plugin name="crc_joint_states" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>30</update_rate>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- IMU -->
  <gazebo reference="imu_link">
    <sensor name="crc_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="crc_imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 360 degree LiDAR -> /scan -->
  <gazebo reference="base_scan">
    <sensor name="crc_lidar" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <pose>0 0 0 0 0 0</pose>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.000000</resolution>
            <min_angle>0.000000</min_angle>
            <max_angle>6.280000</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.120000</min>
          <max>${lidar_range}</max>
          <resolution>0.015000</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="crc_lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>base_scan</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- RGB camera -> /camera/image_raw + /camera/camera_info -->
  <gazebo reference="camera_link">
    <sensor name="crc_camera" type="camera">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>30</update_rate>
      <pose>0.005 0.065 0.013 0 0 0</pose>
      <camera name="rgb">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>50</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.005</stddev>
        </noise>
      </camera>
      <plugin name="crc_camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
        </ros>
        <camera_name>camera</camera_name>
        <frame_name>camera_rgb_optical_frame</frame_name>
        <hack_baseline>0.07</hack_baseline>
      </plugin>
    </sensor>
  </gazebo>

</robot>
